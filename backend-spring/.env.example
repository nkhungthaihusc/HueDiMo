# Copy to .env in this directory and fill in NEW values. Never commit .env.
# Spring loads this file as Java properties: do NOT wrap values in quotes.
SERVER_PORT=8080

# Database. Set host/port/name/user for your PostgreSQL or Supabase pooler.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=
# Optional full JDBC URL override (do not use a postgresql:// URL here):
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/postgres?sslmode=require

# Two DIFFERENT random secrets, each at least 32 bytes for HS256.
JWT_SECRET=
JWT_REFRESH_SECRET=

# AI providers. Empty keys disable the corresponding provider.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENCODE_ZEN_API_KEY=

# Supabase public client/storage configuration.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# OTP email. Use an app password if required by your mail provider.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
