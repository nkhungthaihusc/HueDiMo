# Copy to .env in back-end and fill in new credentials. Never commit .env.
PORT=3002
# Use either DATABASE_URL or the DB_* fields below.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=postgres
JWT_SECRET=
JWT_REFRESH_SECRET=
GEMINI_API_KEY=
OPENCODE_ZEN_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server key for signing Storage uploads. SUPABASE_SECRET_KEY takes precedence.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Optional HTTPS email delivery. When set, Express uses Resend and requires MAIL_FROM.
RESEND_API_KEY=
MAIL_FROM=
# Generate a long random value and share it across Express instances.
AUTH_OTP_SECRET=
# Optional comma-separated trusted proxy IPs or CIDRs for client IP rate limiting.
TRUSTED_PROXY_ADDRESSES=

GOONG_MAP_KEY=
GOONG_MAP_PROXY_ORIGIN=
