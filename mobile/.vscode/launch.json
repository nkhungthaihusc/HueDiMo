{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "mobile",
      "request": "launch",
      "type": "dart"
    },
    {
      "name": "mobile (profile mode)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile"
    },
    {
      "name": "mobile (release mode)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release"
    },
    {
      "name": "xcross: iOS device",
      "type": "dart",
      "request": "launch",
      "debuggerType": "flutter",
      "program": "lib/main.dart",
      "cwd": "${workspaceFolder}",
      "env": {
        "XCROSS": "true"
      },
      "args": []
    }
  ]
}
